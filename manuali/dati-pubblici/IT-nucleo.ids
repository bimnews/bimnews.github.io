        <specification name="IT.ELM.003 · Codice del bene (asset)" ifcVersion="IFC4X3_ADD2" identifier="IT.ELM.003" description="Il codice con cui l'elemento entra nel sistema di gestione e manutenzione dell'ente.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="IFCACTUATOR" />
                            <xs:enumeration value="IFCAIRTERMINAL" />
                            <xs:enumeration value="IFCAIRTERMINALBOX" />
                            <xs:enumeration value="IFCAIRTOAIRHEATRECOVERY" />
                            <xs:enumeration value="IFCALARM" />
