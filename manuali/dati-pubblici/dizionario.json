{"nome":"Dizionario dei dati BIM pubblici · prototipo","versione":"0.1","data":"2026-11-19","stato":"Proposta di BIM News, non è uno standard","livelli":{"IT":{"it":"Nucleo nazionale (proposta)","de":"Nationaler Kern (Vorschlag)","en":"National core (proposal)"},"IT-BZ":{"it":"Estensione Provincia di Bolzano (dal capitolato pubblico)","de":"Erweiterung Provinz Bozen (aus den öffentlichen AIA)","en":"Bolzano Province extension (from the public EIR)"}},"gruppi":{"PRJ":"Progetto e territorio","BLD":"Edificio","STO":"Piani","SPC":"Locali","ELM":"Tutti gli elementi tecnici","WIN":"Finestre"},"fasi":{"PFTE":"Progetto di fattibilità tecnico-economica","PE":"Progetto esecutivo","AB":"Come costruito (as built)","GES":"Gestione"},"parametri":[{"code":"IT.PRJ.001","lv":"IT","g":"PRJ","it":"Codice unico di progetto (CUP)","de":"Projektcode (CUP)","en":"Unique project code (CUP)","d":"Il codice di 15 caratteri che lo Stato assegna a ogni progetto di investimento pubblico. Lega il modello ai dati economici e di monitoraggio già pubblici su OpenCUP.","t":"IfcIdentifier","u":"","v":"15 caratteri alfanumerici","rx":"[A-Z0-9]{15}","ex":"(15 caratteri)","ent":"IfcProject","mk":"cpset","ifc":"IT_Progetto.CUP","f":["PFTE"],"chi":"Ente","src":"L. 3/2003, art. 11 · opencup.gov.it","url":"https://www.opencup.gov.it/portale/web/opencup/cos-%C3%A8-il-cup","eq":"","ver":"0.1","st":"proposta"},{"code":"IT.PRJ.002","lv":"IT","g":"PRJ","it":"Codice IPA dell'ente","de":"IPA-Code der Körperschaft","en":"Public body code (IPA)","d":"Il codice che identifica l'ente proprietario nell'Indice dei domicili digitali delle pubbliche amministrazioni (IPA). Dice di chi è l'opera senza scrivere il nome a mano.","t":"IfcIdentifier","u":"","v":"codice IPA esistente","rx":"","ex":"p_bz (Provincia autonoma di Bolzano)","ent":"IfcProject","mk":"cpset","ifc":"IT_Progetto.CodiceIPA","f":["PFTE"],"chi":"Ente","src":"IndicePA, dataset «Enti», campo Codice_IPA","url":"https://indicepa.gov.it/ipa-dati/dataset/enti","eq