        <specification name="IT-BZ.WIN.002 · Nr. ante" ifcVersion="IFC4X3_ADD2" identifier="IT-BZ.WIN.002" description="Numero di ante della finestra (dal capitolato). IFC descrive la suddivisione con l'attributo PartitioningType (anta singola, doppia, tripla…), ma non ha un numero intero di ante: qui serve un parametro dell'estensione.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWINDOW</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCCOUNTMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>IT_BZ_Finestra</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>NumeroAnte</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
